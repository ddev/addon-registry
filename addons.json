---
---
{%- assign sorted_addons = site.addons | sort_natural -%}
{%- assign total_addons = "" | split: "" -%}
{%- assign official_addons = "" | split: "" -%}
{%- assign contrib_addons = "" | split: "" -%}
{%- for addon in sorted_addons -%}
  {%- if addon.group -%}{%- continue -%}{%- endif -%}
  {%- assign total_addons = total_addons | push: addon -%}
  {%- if addon.user == 'ddev' -%}
    {%- assign official_addons = official_addons | push: addon -%}
  {%- else -%}
    {%- assign contrib_addons = contrib_addons | push: addon -%}
  {%- endif -%}
{%- endfor -%}
{"updated_datetime":{{ site.time | date_to_xmlschema | jsonify }},"total_addons_count":{{ total_addons | size }},"official_addons_count":{{ official_addons | size }},"contrib_addons_count":{{ contrib_addons | size }},"addons":[{%- for addon in total_addons -%}{"title":{{ addon.title | append: '' | jsonify }},"github_url":{{ addon.github_url | append: '' | jsonify }},"description":{{ addon.description | append: '' | jsonify }},"user":{{ addon.user | append: '' | jsonify }},"repo":{{ addon.repo | append: '' | jsonify }},"repo_id":{{ addon.repo_id | to_integer }},"default_branch":{{ addon.default_branch | append: '' | jsonify }},"tag_name":{{ addon.tag_name | append: '' | jsonify }},"ddev_version_constraint":{{ addon.ddev_version_constraint | append: '' | jsonify }},"dependencies":{{ addon.dependencies | jsonify }},"type":{{ addon.type | append: '' | jsonify }},"created_at":{{ addon.created_at | append: '' | jsonify }},"updated_at":{{ addon.updated_at | append: '' | jsonify }},"workflow_status":{{ addon.workflow_status | append: '' | jsonify }},"stars":{{ addon.stars | to_integer }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
